# TinyOffice reads environment variables from the process. This file documents
# optional local overrides; it is not loaded automatically and contains no keys.

# PostgreSQL runtime database
TINYOFFICE_DATABASE_URL=postgresql://tinyoffice:tinyoffice_dev@127.0.0.1:55432/tinyoffice?sslmode=disable

# Local runtime origins and ports
TINYOFFICE_API_BASE_URL=http://127.0.0.1:8095
TINYOFFICE_RUNTIME_ORIGIN=http://127.0.0.1:8095
TINYOFFICE_RUNTIME_PREVIEW_PORT=8095
TINYOFFICE_WEB_PREVIEW_PORT=5175

# Optional update sources
TINYOFFICE_NPM_REGISTRY_URL=https://registry.npmjs.org
TINYOFFICE_UPDATE_MANIFEST_URL=

# Optional web-search providers. Supply keys only in your local environment.
PI_WEBSEARCH_PROVIDER=
BRAVE_API_KEY=
TAVILY_API_KEY=
