{
  "name": "pi-tool-guard",
  "version": "0.1.0",
  "description": "PI tool guard for company-managed read, write, and bash policy.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tool-guard"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:dry-run": "npm pack --dry-run"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.76.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "typescript": "^6.0.3"
  }
}
