{
  "name": "tinyoffice-web-shadcn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs && node scripts/report-bundle-size.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check": "tsc -b --noEmit",
    "check:ui-boundaries": "node scripts/check-ui-boundaries.mjs",
    "check:quality": "npm run check && npm run lint && npm run check:ui-boundaries",
    "test": "node --import tsx --import ./src/i18n/testSetup.ts --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "lint": "oxlint --deny-warnings",
    "analyze:bundle": "node scripts/report-bundle-size.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-query": "^5.104.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.2"
  }
}
